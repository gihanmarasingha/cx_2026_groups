import Lean
import Lake.Toml

/-!
# Course exporter

Run with `lake exe generateStudent` from the project root. The Teacher sources
and `literate-teacher.toml` are the authoring inputs. The release list determines
both the exported library and the Student navigation entries. Check all inputs
before updating the checked-in outputs.

Use the original syntax spans for deletions and import renames. This preserves
Lean formatting and Verso prose, including comments between commands.
-/

open Lean System Lake.Toml

private def teacherRoot : Name := `Cx2026GroupsTeacher
private def studentRoot : Name := `Cx2026Groups
private def sourceConfig : FilePath := "literate-teacher.toml"
private def generatedHeader := "-- Generated by lake exe generateStudent. Edit the Teacher source.\n"

private def studentName (name : Name) : Name :=
  name.replacePrefix teacherRoot studentRoot

private def leanSources (root : Name) : IO (Array FilePath) := do
  let dir : FilePath := root.toString
  let rootFile := dir.addExtension "lean"
  let files ← if ← dir.isDir then dir.walkDir else pure #[]
  let files ← files.filterM fun file =>
    return file.extension == some "lean" && (← file.metadata).type == .file
  let files := files.qsort (fun a b => a.toString < b.toString)
  return if ← rootFile.pathExists then #[rootFile] ++ files else files

private def moduleName (file : FilePath) : Name :=
  (file.withExtension "").components.foldl Name.str .anonymous

private def modulePath (name : Name) : FilePath :=
  (FilePath.mk ("/".intercalate (name.toString.splitOn "."))).addExtension "lean"

/-- Keep the copyright notice first so Mathlib's header linter can read it. -/
private def splitCopyright (source : String) : String × String :=
  if source.startsWith "/-\nCopyright (c) " then
    match source.splitOn "\n-/\n" with
    | header :: body :: rest => (header ++ "\n-/\n", "\n-/\n".intercalate (body :: rest))
    | _ => ("", source)
  else ("", source)

private def failOnErrors (messages : MessageLog) : IO Unit := do
  if messages.hasErrors then
    let errors ← (messages.toList.filter (·.severity == .error)).mapM (·.toString)
    throw <| IO.userError ("".intercalate errors)

private def readConfig : IO Table := do
  let input ← IO.FS.readFile sourceConfig
  match ← loadToml (Parser.mkInputContext input sourceConfig.toString) |>.toBaseIO with
  | .ok table => pure table
  | .error messages =>
    failOnErrors messages
    throw <| IO.userError s!"Could not read {sourceConfig}"

private def tableAt (table : Table) (key : Name) : IO Table := do
  let some (.table _ fields) := table.find? key
    | throw <| IO.userError s!"Expected [{key}] in {sourceConfig}"
  pure fields

private def stringArrayAt (table : Table) (key : Name) : IO (Array String) := do
  let some (.array _ values) := table.find? key
    | throw <| IO.userError s!"Expected student.{key} in {sourceConfig}"
  values.mapM fun
    | .string _ value => pure value
    | _ => throw <| IO.userError s!"Expected strings in student.{key}"

private def releasedModules (weeks : Array String) (teacherModules : Array Name) : IO (Array Name) := do
  let weekRoots := weeks.map (Name.str teacherRoot)
  for week in weekRoots do
    unless teacherModules.contains week do
      throw <| IO.userError s!"Released week {week} has no Teacher overview"
  return teacherModules.filter fun name =>
    name == teacherRoot || weekRoots.any (·.isPrefixOf name)

/-- Verso stores a dotted module key as one quoted TOML key. -/
private def moduleKey (name : Name) : Name :=
  Name.mkSimple name.toString

private def projectConfig (source settings : Table) (released : Array Name) (combined : Bool) :
    IO String := do
  let modules ← tableAt source `modules
  let studentOverview ← tableAt modules studentRoot
  let mut studentModules := Table.empty
  for name in released do
    if name != teacherRoot then
      -- A module without an override uses Verso's default title and URL.
      if let some value := modules.find? (moduleKey name) then
        studentModules := RBDict.insert (moduleKey (studentName name)) value studentModules
  let source := source.filter (fun key _ => key != `student)
  if combined then
    let both := studentModules.items.foldl (fun acc (key, value) => RBDict.insert key value acc) modules
    return "# Generated from literate-teacher.toml.\n" ++
      ppTable (RBDict.insert `modules (.table .missing both) source)
  let some (.string _ title) := settings.find? `overview_title
    | throw <| IO.userError s!"Expected student.overview_title in {sourceConfig}"
  let hideCommands ← stringArrayAt settings `hide_commands
  let studentOverview := studentOverview.insert `title title
  studentModules := RBDict.insert studentRoot (.table .missing studentOverview) studentModules
  let targets := #[Lake.toToml (Table.empty.insert `library studentRoot.toString)]
  let output := source.filter (fun key _ => key != `order)
  let output := RBDict.insert `targets (.array .missing targets) output
  let output := RBDict.insert `modules (.table .missing studentModules) output
  let output := RBDict.insert `hide_commands (Lake.toToml hideCommands) output
  return "# Generated by lake exe generateStudent. Edit literate-teacher.toml.\n" ++ ppTable output

private structure Edit where
  range : Syntax.Range
  replacement : String := ""

private def sourceRange (ctx : Parser.InputContext) (stx : Syntax) : IO Syntax.Range :=
  match stx.getRange? with
  | some span => pure span
  | none => throw <| IO.userError s!"{ctx.fileName}: missing source span"

/--
Delete whole lines for hidden commands, including any trailing line comment.
Keep nearby shared prose and comments. A hidden command must occupy its own
lines so its removal cannot leave a trailing comment or alter another command.
-/
private def deleteCommand (ctx : Parser.InputContext) (stx : Syntax) (collapseGap := false) :
    IO Edit := do
  let span ← sourceRange ctx stx
  let map := ctx.fileMap
  let startLine := map.toPosition span.start
  let endLine := map.toPosition span.stop
  let start := map.positions[startLine.line - 1]!
  let stop := map.positions[endLine.line]?.getD span.stop
  let leading := String.Pos.Raw.extract ctx.inputString start span.start
  let suffix := (String.Pos.Raw.extract ctx.inputString span.stop stop).trimAscii
  unless leading.trimAscii.isEmpty && (suffix.isEmpty || suffix.startsWith "--") do
    throw <| IO.userError s!"{ctx.fileName}:{startLine.line}: put the hidden command on its own lines, with any trailing comment written using --"
  let start :=
    if collapseGap && startLine.line > 1 &&
        (stop.atEnd ctx.inputString || stop.get ctx.inputString == '\n') then
      let previous := map.positions[startLine.line - 2]!
      if (String.Pos.Raw.extract ctx.inputString previous start).trimAscii.isEmpty then previous
      else start
    else start
  pure { range := ⟨start, stop⟩ }

private def importEdits (ctx : Parser.InputContext) (header : Elab.HeaderSyntax) (name : Name)
    (released : Array Name) : IO (Array Edit) := do
  let `(Parser.Module.header| $[module]? $[prelude]? $imports*) := header
    | throw <| IO.userError s!"{ctx.fileName}: unrecognized module header"
  let mut edits := #[]
  for stx in imports do
    let `(Parser.Module.import| $[public]? $[meta]? import $[all]? $mod:ident) := stx
      | throw <| IO.userError s!"{ctx.fileName}: unrecognized import"
    let imported := mod.getId
    if imported == `Cx2026GroupsAuthoring || imported == `Mathlib.Tactic.Linter.MinImports then
      edits := edits.push (← deleteCommand ctx stx)
    else if teacherRoot.isPrefixOf imported then
      if released.contains imported then
        edits := edits.push { range := ← sourceRange ctx mod, replacement := (studentName imported).toString }
      else if name == teacherRoot && imported.getPrefix == teacherRoot then
        edits := edits.push (← deleteCommand ctx stx)
      else
        throw <| IO.userError s!"{ctx.fileName}: a released lesson imports unreleased module {imported}"
  pure edits

private def moduleSetup (file : String) : IO ModuleSetup := do
  let lake := (← IO.getEnv "LAKE").getD "lake"
  let result ← IO.Process.output { cmd := lake, args := #["setup-file", file] }
  unless result.exitCode == 0 do
    throw <| IO.userError s!"Lake could not set up {file}\n{result.stderr}"
  match Json.parse result.stdout >>= fromJson? with
  | .ok setup => pure setup
  | .error message => throw <| IO.userError s!"Invalid Lake setup for {file}: {message}"

private unsafe def commandEdits (ctx : Parser.InputContext) (header : Elab.HeaderSyntax)
    (parserState : Parser.ModuleParserState) : IO (Array Edit) := do
  let setup ← moduleSetup ctx.fileName
  setup.dynlibs.forM Lean.loadDynlib
  let opts := setup.options.toOptions
  -- Importing resets this flag when it finishes.
  Lean.enableInitializersExecution
  let (env, messages) ← Elab.processHeaderCore header.startPos
    (setup.imports?.getD header.imports) (setup.isModule || header.isModule) opts {} ctx
    (plugins := setup.plugins) (mainModule := setup.name) (package? := setup.package?)
    (arts := setup.importArts) (headerStx? := header)
  failOnErrors messages
  let state ← Elab.IO.processCommands ctx parserState (Elab.Command.mkState env messages opts)
  failOnErrors state.commandState.messages
  let mut edits := #[]
  for stx in state.commands do
    if stx.isOfKind ``Parser.Command.exit then
      throw <| IO.userError s!"{ctx.fileName}: #exit prevents the exporter from checking the rest of the file"
    if stx.isOfKind `teacherOnly || stx.isOfKind `Mathlib.Linter.MinImports.«command#import_bumps» then
      edits := edits.push (← deleteCommand ctx stx (collapseGap := true))
    else
      for node in stx.topDown do
        if node.isOfKind `teacherOnly then
          throw <| IO.userError s!"{ctx.fileName}: put teacher_only in at the top level of the lesson"
  pure edits

private def applyEdits (ctx : Parser.InputContext) (edits : Array Edit) : IO String := do
  let mut cursor : String.Pos.Raw := 0
  let mut output := ""
  for edit in edits do
    if edit.range.start < cursor then
      throw <| IO.userError s!"{ctx.fileName}: overlapping source edits"
    output := output ++ String.Pos.Raw.extract ctx.inputString cursor edit.range.start ++ edit.replacement
    cursor := edit.range.stop
  pure (output ++ String.Pos.Raw.extract ctx.inputString cursor ⟨ctx.inputString.utf8ByteSize⟩)

private unsafe def exportLesson (file : FilePath) (name : Name) (released : Array Name) :
    IO (FilePath × String) := do
  let ctx := Parser.mkInputContext (← IO.FS.readFile file) file.toString
  let (header, parserState, messages) ← Parser.parseHeader ctx
  failOnErrors messages
  let headerEdits ← importEdits ctx header name released
  let bodyEdits ← commandEdits ctx header parserState
  let output ← applyEdits ctx (headerEdits ++ bodyEdits)
  let (copyright, body) := splitCopyright output
  pure (modulePath (studentName name), copyright ++ generatedHeader ++ body)

private def currentText (path : FilePath) : IO (Option String) := do
  if ← path.pathExists then some <$> IO.FS.readFile path else pure none

private def writeOutputs (outputs : Array (FilePath × String)) (check : Bool) : IO Unit := do
  let paths := outputs.map Prod.fst
  let stale := (← leanSources studentRoot).filter (!paths.contains ·)
  let mut changed := #[]
  for (path, expected) in outputs do
    if (← currentText path) != some expected then
      changed := changed.push (path, expected)
  if check then
    unless changed.isEmpty && stale.isEmpty do
      let files := (changed.map (·.1.toString) ++ stale.map (·.toString)).toList
      throw <| IO.userError s!"Run lake exe generateStudent to update these files:\n{String.intercalate "\n" files}"
  else
    -- A lesson removed from the release list must disappear from Verso's source scan.
    for path in stale do
      unless (splitCopyright (← IO.FS.readFile path)).2.startsWith generatedHeader do
        throw <| IO.userError s!"Unexpected Student source {path}. Move it into the Teacher tree or remove it before generating."
    for (path, expected) in changed do
      if let some parent := path.parent then
        IO.FS.createDirAll parent
      IO.FS.writeFile path expected
    stale.forM IO.FS.removeFile
  IO.println s!"Student export {if check then "checked" else "generated"} ({outputs.size - 1} Lean files and literate.toml)."

unsafe def main (args : List String) : IO Unit := do
  let source ← readConfig
  let settings ← tableAt source `student
  let files ← leanSources teacherRoot
  let names := files.map moduleName
  unless names.contains teacherRoot do
    throw <| IO.userError "Missing Teacher course overview"
  let released ← releasedModules (← stringArrayAt settings `released_weeks) names
  if let ["--combined-config", path] := args then
    IO.FS.writeFile path (← projectConfig source settings released true)
    return
  unless args == [] || args == ["--check"] do
    throw <| IO.userError "Usage: lake exe generateStudent [--check | --combined-config FILE]"
  Lean.initSearchPath (← Lean.findSysroot)
  let config ← projectConfig source settings released false
  let mut outputs := #[(⟨"literate.toml"⟩, config)]
  for (file, name) in files.zip names do
    if released.contains name then
      outputs := outputs.push (← exportLesson file name released)
  writeOutputs outputs (args == ["--check"])
