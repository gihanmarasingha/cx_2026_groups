{
  "name": "Leaning into Group Theory",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=${devcontainerId}-lake,target=${containerWorkspaceFolder}/.lake,type=volume"
  ],
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "onCreateCommand": "sudo chown vscode:vscode .lake",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": ["leanprover.lean4"]
    },
    "codespaces": {
      "openFiles": ["Cx2026Groups/Week1/Week1_0.lean"]
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Course website",
      "onAutoForward": "notify"
    }
  }
}
